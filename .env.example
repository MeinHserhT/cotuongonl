# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://cotuongonl.vercel.app"

# NEXT_PUBLIC_WS_SERVER_URL: Optional external WebSocket URL (e.g. wss://cotuongonl.onrender.com/api/ws).
# Leave empty to automatically connect to the same host's /api/ws endpoint.
NEXT_PUBLIC_WS_SERVER_URL=""
